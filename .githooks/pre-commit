#!/usr/bin/env bash
set -euo pipefail

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.c' '*.cc' '*.cpp' '*.cxx' '*.h' '*.hh' '*.hpp' '*.tpp')

[ -z "$files" ] && exit 0

# The clang-format major version is pinned in scripts/clang-format-version.sh.
# shellcheck source=scripts/clang-format-version.sh
source "$(git rev-parse --show-toplevel)/scripts/clang-format-version.sh"
resolve_clang_format || exit 1

changed=0
for file in $files; do
  "$CLANG_FORMAT_BIN" -i "$file"

  if ! git diff --quiet -- "$file"; then
    git add -- "$file"
    changed=1
  fi
done

if [ "$changed" -eq 1 ]; then
  echo "clang-format updated staged files; they have been added to the commit."
fi
